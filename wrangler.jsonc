{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "insa-command",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "insa-command",
      "database_id": "COLE_AQUI_O_ID_DO_D1",
      "migrations_dir": "migrations"
    }
  ],
  // Cotações: a cada 5 minutos (o código só consulta no pregão, e 1x/hora fora dele)
  "triggers": { "crons": ["*/5 * * * *"] },
  "observability": { "enabled": true }
  // Segredos (NUNCA neste arquivo): wrangler secret put SETUP_TOKEN | BRAPI_TOKEN | GEMINI_API_KEY | ANTHROPIC_API_KEY
}
